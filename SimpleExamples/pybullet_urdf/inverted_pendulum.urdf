<robot name="pendulum">
    <link name="base">
        <inertial>
            <mass value="0.15"/>
            <collision>
                <geometry>
                    <box size="0.1 0.1 0.1"/>
                </geometry>
            </collision>
        </inertial>
    </link>
    <link name="rod">
        <inertial>
            <mass value="0.15"/>
            <collision>
                <geometry>
                    <cylinder radius="0.01" length="0.5"/>
                </geometry>
            </collision>
        </inertial>
    </link>
    <joint name="hinge" type="revolute">
        <parent link="base"/>
        <child link="rod"/>
        <axis xyz="0 0 1"/>
        <origin rpy="0 0 0" xyz="0 0 0.25"/>
    </joint>
</robot>
